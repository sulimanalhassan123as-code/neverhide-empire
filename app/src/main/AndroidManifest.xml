<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Foreground service types ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ===== Core ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ===== Cyber Cleaner suite (v2.6.0) ===== -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===== Deep-sleep survival ===== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:ignore="ExactAlarm" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===== Camera / flashlight ===== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- ===== Biometrics ===== -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ===== Location / weather / tracker ===== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ===== Phone / dialer ===== -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- ===== Audio ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ===== Health / body sensors ===== -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />

    <!-- ===== Calendar / clock ===== -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SET_ALARM" />

    <!-- ===== System stats (best-effort, harmless if not granted) ===== -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===== Storage: scoped for API 33+, legacy for older ===== -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".EmpireApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.NeverhideEmpire"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!-- ===== Main Hub Activity ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".cleaner.CleanerActivity"
            android:exported="false"
            android:label="Cyber Cleaner" />
        <activity android:name=".vault.AppVaultActivity"
            android:exported="false"
            android:label="App Vault" />
        <activity android:name=".talk.EmpireTalkActivity"
            android:exported="false"
            android:label="Empire Talk" />
        <service
            android:name=".firebase.EmpireMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name=".calls.QuickDialActivity"
            android:exported="false"
            android:label="Quick Dial" />
        <activity android:name=".quran.QuranActivity"
            android:exported="false"
            android:label="Quran Audio" />
        <activity android:name=".calls.CallRecordingsActivity"
            android:exported="false"
            android:label="Call Recorder" />
        <service android:name=".calls.CallRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <activity android:name=".calls.VoiceStudioActivity"
            android:exported="false"
            android:label="Voice Studio" />
        <activity android:name=".tools.compass.ArCompassActivity"
            android:exported="false"
            android:label="AR Compass &amp; Level" />
        <service android:name=".tools.scanner.SecurityPatrolJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service android:name=".quran.QuranDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service android:name=".quran.QuranPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ===== Tools Hub Activity ===== -->
        <activity
            android:name=".tools.ToolsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- ===== 3D Launcher Activity ===== -->
        <activity
            android:name=".launcher.Launcher3DActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.NeverhideEmpire.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ===== Guardian Jumpscare (shows over lock screen) ===== -->
        <activity
            android:name=".guardian.JumpscareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.NeverhideEmpire.Fullscreen" />

        <!-- ===== Screenshot Services ===== -->
        <service
            android:name=".screenshot.ScreenshotService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <service
            android:name=".screenshot.ScreenshotTile"
            android:exported="true"
            android:icon="@drawable/ic_screenshot"
            android:label="@string/qs_screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".screenshot.FloatingBubbleService"
            android:exported="false" />

        <!-- ===== Live Wallpaper ===== -->
        <service
            android:name=".wallpaper.LiveWallpaperEngine"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <!-- ===== Persistent Background Service (deep-sleep resistant) ===== -->
        <service
            android:name=".core.EmpireBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            tools:ignore="ForegroundServicePermission">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent watchdog keeping Empire tools alive" />
        </service>

        <!-- ===== Eye Care overlay service ===== -->
        <service
            android:name=".tools.eyecare.EyeCareService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:ignore="ForegroundServicePermission" />

        <!-- ===== Find-my-phone siren service ===== -->
        <service
            android:name=".tools.siren.SirenService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:ignore="ForegroundServicePermission" />

        <!-- ===== Guardian Admin Receiver (wrong password detection) ===== -->
        <receiver
            android:name=".guardian.GuardianAdminReceiver"
            android:exported="true"
            android:label="@string/guardian_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ===== Guardian Capture Service (foreground camera+location for alerts) ===== -->
        <service
            android:name=".guardian.GuardianCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|location" />

        <!-- ===== Boot Receiver (restart everything) ===== -->
        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>


        <!-- ===== Watchdog restart alarm receiver ===== -->
        <receiver
            android:name=".core.RestartReceiver"
            android:exported="false" />
        <!-- ===== Battery guard (low battery alarm) ===== -->
        <receiver
            android:name=".core.BatteryGuardReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

        <!-- ===== SIM change guard (anti-theft) ===== -->
        <receiver
            android:name=".tools.tracker.SimGuardReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ===== File Provider ===== -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
